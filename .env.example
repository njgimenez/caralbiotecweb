APP_ENV=local
APP_KEY=

# Base de datos (Docker host es 'db')
DB_HOST=db
DB_PORT=3306
DB_DATABASE=caralweb
DB_USERNAME=caraluser
DB_PASSWORD=caralpassword
DB_ROOT_PASSWORD=rootpassword

# Izipay checkout web
# En local se usa demo para probar sin cobrar ni requerir credenciales.
IZIPAY_ENV=sandbox
IZIPAY_DEMO_MODE=true
IZIPAY_MERCHANT_CODE=
IZIPAY_TOKEN_SESSION=
IZIPAY_KEY_RSA=
