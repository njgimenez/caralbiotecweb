APP_ENV=local
APP_KEY=

# Base de datos (Docker host es 'db')
DB_HOST=db
DB_PORT=3306
DB_DATABASE=caralweb
DB_USERNAME=caraluser
DB_PASSWORD=caralpassword
DB_ROOT_PASSWORD=rootpassword

# Izipay FormToken / Popin / IPN
# El switch del admin decide si usa test o production para nuevos pagos.
IZIPAY_MODE=test
IZIPAY_TEST_USERNAME=
IZIPAY_TEST_PASSWORD=
IZIPAY_TEST_PUBLIC_KEY=
IZIPAY_TEST_HMAC_SHA256=
IZIPAY_PROD_USERNAME=
IZIPAY_PROD_PASSWORD=
IZIPAY_PROD_PUBLIC_KEY=
IZIPAY_PROD_HMAC_SHA256=
IZIPAY_CREATE_PAYMENT_ENDPOINT=https://api.micuentaweb.pe/api-payment/V4/Charge/CreatePayment
IZIPAY_DEFAULT_ZIP_CODE=15000

# Token temporal para ejecutar /update_izipay_schema.php y /backup_database.php
SCHEMA_UPDATE_TOKEN=
