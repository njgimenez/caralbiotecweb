APP_ENV=production
APP_KEY=change-this-random-32-char-key

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_caralweb
DB_USERNAME=cpaneluser_caraluser
DB_PASSWORD=change-this-password

# Izipay FormToken / Popin / IPN
# El switch del admin decide si usa test o production para nuevos pagos.
IZIPAY_MODE=production
IZIPAY_TEST_USERNAME=change_this_test
IZIPAY_TEST_PASSWORD=change_this_test
IZIPAY_TEST_PUBLIC_KEY=change_this_test
IZIPAY_TEST_HMAC_SHA256=change_this_test
IZIPAY_PROD_USERNAME=change_this_prod
IZIPAY_PROD_PASSWORD=change_this_prod
IZIPAY_PROD_PUBLIC_KEY=change_this_prod
IZIPAY_PROD_HMAC_SHA256=change_this_prod
IZIPAY_CREATE_PAYMENT_ENDPOINT=https://api.micuentaweb.pe/api-payment/V4/Charge/CreatePayment
IZIPAY_DEFAULT_ZIP_CODE=15000

# Token temporal para ejecutar /update_izipay_schema.php y /backup_database.php
SCHEMA_UPDATE_TOKEN=change_this_temporary_token
